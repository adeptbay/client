# ─────────────────────────────────────────────────────────────
# AdeptBay — environment
# Copy to .env.local for development. Set the same keys in Vercel.
# Nothing here is required to build or deploy the MVP.
# ─────────────────────────────────────────────────────────────

# Canonical origin. Used for canonical URLs, sitemaps, OG images, schema.
# REQUIRED in production — the build fails without it rather than fall back
# to the generated *.vercel.app host and hand Google the wrong canonical.
# Preview deployments fall back to VERCEL_PROJECT_PRODUCTION_URL on purpose.
NEXT_PUBLIC_SITE_URL=https://adeptbay.com

# ── Feature flags (Part 6 · flags.ts) ────────────────────────
# Every one of these is OFF by default. Turn them on as the ladder is climbed.
NEXT_PUBLIC_FLAG_ADS=false            # Part 8 — only after AdSense approval
NEXT_PUBLIC_FLAG_PREMIUM=false        # Part 10 — only after 20k monthly visitors
NEXT_PUBLIC_FLAG_API=false            # Part 10 — public developer API
NEXT_PUBLIC_FLAG_AI=false             # Part 7 — AI-backed tools
NEXT_PUBLIC_FLAG_NEWSLETTER=false     # Part 3 — engine 2, at 5k monthly visitors
NEXT_PUBLIC_FLAG_ANALYTICS=false      # privacy-first analytics beacon

# ── Analytics (self-hosted Umami / Plausible — Appendix E) ───
# Setting a URL here also adds its origin to the CSP connect-src, so the
# beacon is not silently blocked. Must be an absolute URL.
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# ── AdSense (Part 8) ─────────────────────────────────────────
# Setting a client id also widens the CSP to Google's documented ad hosts.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Search engines (Part 5.9) ────────────────────────────────
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── AI layer (Part 7) — provider-agnostic, fetch based ───────
# Leave empty and NEXT_PUBLIC_FLAG_AI=false to ship without any AI cost.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_BALANCED=claude-sonnet-5
AI_MODEL_DEEP=claude-opus-5
AI_DAILY_BUDGET_USD=5

# ── Groq (src/ai/groq.ts) ────────────────────────────────────
# Used by layer 3 of the CV checker only. Layers 1 and 2 — the parse,
# the score and every finding — run in the browser and never touch this,
# so an unset key degrades one panel rather than the tool.
#
# GROQ_MODELS is an ordered fallback chain. Groq retires model ids on
# short notice; a single hard-coded id is an outage waiting for a
# Tuesday. Leave empty to use the built-in chain.
GROQ_API_KEY=
GROQ_MODELS=
